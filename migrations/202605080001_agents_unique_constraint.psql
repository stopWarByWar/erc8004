-- 先删除重复行（保留 uid 最小的那条，即最早插入的）
DELETE FROM agents a
WHERE a.uid NOT IN (
    SELECT MIN(uid)
    FROM agents
    GROUP BY chain_id, identity_registry, agent_id
);

-- 将旧的普通索引升级为唯一约束
DROP INDEX IF EXISTS idx_agents_item;
ALTER TABLE agents
    ADD CONSTRAINT uq_agents_chain_registry_agent
    UNIQUE (chain_id, identity_registry, agent_id);
