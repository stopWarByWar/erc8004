create table if not exists validations (
    agent_uid bigint not null,

    chain_id varchar(255) not null,
    agent_id varchar(255) not null,
    validation_registry char(42) not null,

    validator_address char(42) not null,

    request_hash char(66) not null,
    request_uri varchar(255) not null,

    response int not null,
    response_uri varchar(255) not null,
    response_hash char(66) not null,
    tag1 varchar(255) not null,

    block_number bigint not null,
    index bigint not null,
    request_tx_hash char(66) primary key not null,
    response_tx_hash char(66),
    timestamps bigint not null,
    constraint uniq_block_number_index unique (block_number, index)
);

create index if not exists idx_validation_resp_block_index on validations(block_number, index);
create index if not exists idx_validation_resp_agent_uid on validations(agent_uid);
create index if not exists idx_validation_resp_agent on validations(chain_id, validation_registry, agent_id, request_hash);

create table if not exists validators (
    address char(42) primary key not null,
    pending_amount bigint not null default 0,
    finished_amount bigint not null default 0
);

create index if not exists idx_validators_address on validators(address);
create index if not exists idx_validators_finished_amount on validators(finished_amount);

-- Function 1: 新增验证请求时，pending_amount加1
CREATE OR REPLACE FUNCTION increment_pending_amount_on_new_validation()
RETURNS TRIGGER AS $$
BEGIN
  UPDATE validators
  SET pending_amount = pending_amount + 1
  WHERE address = NEW.validator_address;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_increment_pending_amount_on_new_validation
AFTER INSERT ON validations
FOR EACH ROW
EXECUTE FUNCTION increment_pending_amount_on_new_validation();

-- Function 2: 验证请求更新（response_tx_hash变为非空）时，pending_amount减1，finished_amount加1
CREATE OR REPLACE FUNCTION update_validator_status_on_validation_response()
RETURNS TRIGGER AS $$
BEGIN
  -- 若旧的response_tx_hash不为空，则什么都不做
  IF COALESCE(OLD.response_tx_hash, '') <> '' THEN
    RETURN NEW;
  END IF;

  -- 若更新后的response_tx_hash还是为空，也什么都不做
  IF COALESCE(NEW.response_tx_hash, '') = '' THEN
    RETURN NEW;
  END IF;

  -- response_tx_hash由空变为非空，pending_amount减1，finished_amount加1
  UPDATE validators
  SET pending_amount = GREATEST(pending_amount - 1, 0), -- 防止减成负数
      finished_amount = COALESCE(finished_amount, 0) + 1
  WHERE address = NEW.validator_address;

  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_update_validator_status_on_validation_response
AFTER UPDATE OF response_tx_hash ON validations
FOR EACH ROW
EXECUTE FUNCTION update_validator_status_on_validation_response();



