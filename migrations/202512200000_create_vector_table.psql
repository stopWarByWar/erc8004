
CREATE EXTENSION IF NOT EXISTS vector;

CREATE TABLE IF NOT EXISTS agent_vectors (
  uid serial PRIMARY KEY,
  agent_uid bigint NOT NULL UNIQUE,
  identity_registry varchar(255) NOT NULL,
  chain_id varchar(255) NOT NULL,
  create_timestamp bigint NOT NULL,
  embedding vector(1536) NOT NULL,
  content text,
  metadata jsonb,
  created_at bigint
);

CREATE INDEX IF NOT EXISTS idx_agent_vectors_agent_uid ON agent_vectors(agent_uid);
CREATE INDEX IF NOT EXISTS idx_agent_vectors_identity_registry ON agent_vectors(identity_registry);
CREATE INDEX IF NOT EXISTS idx_agent_vectors_chain_id ON agent_vectors(chain_id);
CREATE INDEX IF NOT EXISTS idx_agent_vectors_create_timestamp ON agent_vectors(create_timestamp);

CREATE INDEX IF NOT EXISTS idx_agent_vectors_chain_identity ON agent_vectors(chain_id, identity_registry);
CREATE INDEX IF NOT EXISTS idx_agent_vectors_agent_chain ON agent_vectors(agent_uid, chain_id);

-- 为 agent_vectors 表的 agent_uid 字段添加唯一约束
-- 注意：如果表中已有重复的 agent_uid，需要先清理重复数据

-- 检查并删除重复的 agent_uid（保留最新的记录）
DELETE FROM agent_vectors a
USING agent_vectors b
WHERE a.uid < b.uid
  AND a.agent_uid = b.agent_uid;

-- 添加唯一约束
ALTER TABLE agent_vectors 